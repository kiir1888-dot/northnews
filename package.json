{
  "name": "north-i",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "North i — a modern, data-driven news & magazine web application.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --no-warnings server/index.js",
    "server:dev": "nodemon --no-warnings server/index.js",
    "mail:test": "node --no-warnings server/testMail.js",
    "db:setup": "node --no-warnings scripts/db-setup.js",
    "db:migrate-local": "node --no-warnings scripts/migrate-sqlite.js",
    "dev:all": "concurrently -n CLIENT,SERVER -c blue,green \"npm:dev\" \"npm:server:dev\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
