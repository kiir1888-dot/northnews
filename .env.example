# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Supabase (admin login) ---------------------------------------------
# Frontend (safe to expose to the browser — the anon key only grants what
# your Supabase project's auth/RLS rules allow):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Backend only — NEVER expose the service role key to the browser or commit it:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated allowlist of emails permitted to use the admin dashboard.
# Anyone can otherwise create a Supabase Auth account on your project, so
# this is what actually restricts who can manage the site.
# Leave empty during local setup to allow any signed-in Supabase user
# (NOT recommended once you invite real users) — set this before deploying.
ADMIN_EMAILS=you@example.com,editor@example.com

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
