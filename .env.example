# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Supabase (admin login) ---------------------------------------------
# Frontend (safe to expose to the browser — the anon key only grants what
# your Supabase project's auth/RLS rules allow):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Backend only — NEVER expose the service role key to the browser or commit it:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of OWNER emails. Owners always have full admin access
# and cannot be removed from the dashboard. Add other editors and admins from
# the dashboard's Editors page instead of listing them here.
# Leave empty during local setup to allow any signed-in Supabase user
# (NOT recommended once you invite real users). Set this before deploying.
ADMIN_EMAILS=you@example.com

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Public address of the site, used for newsletter unsubscribe links.
# e.g. https://north-i.com  (defaults to the address the admin is using)
SITE_URL=

# Set to 1 when running behind a reverse proxy / hosting platform so the
# spam rate limits see each reader's real IP address.
TRUST_PROXY=

# --- Email (optional) -----------------------------------------------------
# Needed to send newsletters and to email you when a contact message or
# story submission arrives. Leave blank to skip email; everything is still
# saved in the dashboard. Use your email provider's SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NORTH i <newsnorthi08@gmail.com>"
# Where new contact messages and submissions are announced:
NOTIFY_EMAIL=
